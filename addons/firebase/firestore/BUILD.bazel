load("@autoload_rules_godot//godot:defs.bzl", "godot_addon")
load("@autoload_rules_godot//godot/extension:defs.bzl", "godot_cc_extension")

package(default_visibility = ["//visibility:private"])

# Cloud Firestore: the FirebaseFirestore class, whose methods return a FirestoreTask that
# completes later. It needs Firebase Core, whose autoload initializes the default app.
godot_addon(
    name = "firestore",
    directory = "addons/firebase_firestore",
    visibility = ["//visibility:public"],
    deps = [
        ":firebase_firestore",
        "//core",
    ],
)

# The name is unique across all add-ons and applications: on iOS it names the framework.
godot_cc_extension(
    name = "firebase_firestore",
    srcs = ["//firestore/native:registration"],
    entry_symbol = "firebase_firestore_init",
    platform_deps = select({
        "@platforms//os:android": ["//firestore/native/backends/android:plugin"],
        # The Firebase framework the iOS backend links, which the application embeds.
        "@platforms//os:ios": ["//ios:firestore.bundle"],
        "//conditions:default": [],
    }),
    resource_path = "addons/firebase_firestore/firebase_firestore.gdextension",
    target_compatible_with = select({
        "@platforms//os:osx": [],
        "@platforms//os:ios": [],
        "@platforms//os:linux": [],
        "@platforms//os:android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//firestore/native"] + select({
        "@autoload_rules_godot//godot:tool": ["//firestore/native/backends/unsupported"],
        "@platforms//os:ios": ["//firestore/native/backends/apple"],
        "@platforms//os:android": ["//firestore/native/backends/android"],
        "//conditions:default": ["//firestore/native/backends/unsupported"],
    }),
)
