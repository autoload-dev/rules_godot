load("@autoload_rules_godot//godot:defs.bzl", "godot_addon")
load("@autoload_rules_godot//godot/extension:defs.bzl", "godot_extension")

package(default_visibility = ["//visibility:private"])

# Sentry for Godot (github.com/getsentry/sentry-godot), its prebuilt release: crash and error
# reporting configured by the project settings sentry/*, with the class SentrySDK. The
# add-on holds the release's GDScript user-feedback UI; the release's descriptor stays out,
# since the extension writes its own.
godot_addon(
    name = "sentry",
    srcs = ["@sentry_godot//:user_feedback"],
    directory = "addons/sentry",
    visibility = ["//visibility:public"],
    deps = [":sentry_extension"],
)

# Release builds take Sentry's release libraries; debug builds, source runs and the editor
# its debug libraries, as Sentry's own descriptor maps them. The editor loads the library of
# its host, macOS or Linux.
godot_extension(
    name = "sentry_extension",
    data = select({
        "@platforms//os:linux": ["@sentry_godot//:linux_crashpad_handler"],
        "//conditions:default": [],
    }),
    entry_symbol = "sentry_gdextension_init",
    library = select(
        {
            "@platforms//os:android": ":android",
            "@platforms//os:ios": ":ios",
            "@platforms//os:linux": ":linux",
            "@platforms//os:macos": ":macos",
        },
        no_match_error = "Sentry for Godot is wired for Android, iOS, Linux and macOS",
    ),
    platform_deps = select({
        "@platforms//os:android": [":android_plugin"],
        "@platforms//os:ios": ["@sentry_godot//:sentry_cocoa_ios"],
        "//conditions:default": [],
    }),
    resource_path = "addons/sentry/sentry.gdextension",
)

[
    alias(
        name = name,
        actual = select({
            "@autoload_rules_godot//godot:release": "@sentry_godot//:%s_release" % name,
            "//conditions:default": "@sentry_godot//:%s_debug" % name,
        }),
    )
    for name in [
        "android",
        "android_plugin",
        "ios",
        "linux",
        "macos",
    ]
]
