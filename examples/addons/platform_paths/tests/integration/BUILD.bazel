load("@autoload_gdunit//:defs.bzl", "gdunit_test")
load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_testonly = True)

godot_resources(
    name = "suites",
    srcs = [
        "PlatformPathsTest.gd",
        "PlatformPathsTest.gd.uid",
    ],
    prefix = "integration",
    visibility = ["//addons/platform_paths/tests:__pkg__"],
    deps = [
        ":fixtures",
        "//addons/platform_paths",
        "@autoload_gdunit//:gdunit",
    ],
)

gdunit_test(
    name = "integration",
    size = "small",
    project = "//addons/platform_paths/tests:tests",
    suites = [":suites"],
)

godot_resources(
    name = "fixtures",
    srcs = [
        "fixtures/documents-only-user-dirs.dirs.tpl",
        "fixtures/malformed-user-dirs.dirs.tpl",
        "fixtures/user-dirs.dirs.tpl",
    ],
    prefix = "integration",
)
