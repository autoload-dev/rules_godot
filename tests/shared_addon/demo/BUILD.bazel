load("@autoload_gdunit//:defs.bzl", "gdunit_test")
load("@autoload_rules_godot//godot:defs.bzl", "godot_project", "godot_resources")

# A second project that uses the shared add-on, with a GdUnit suite of its own.
godot_resources(
    name = "main",
    srcs = [
        "main/badge.svg",
        "main/badge.svg.import",
        "main/main.gd",
        "main/main.gd.uid",
        "main/main.tscn",
    ],
    deps = ["//shared_addon:native_counter"],
)

godot_resources(
    name = "suites",
    testonly = True,
    srcs = [
        "tests/CounterTest.gd",
        "tests/CounterTest.gd.uid",
    ],
    deps = [
        ":main",
        "@autoload_gdunit//:gdunit",
    ],
)

gdunit_test(
    name = "consumer_uses_shared_counter_test",
    size = "small",
    project = ":consumer_uses_shared_counter_test_project",
    suites = [":suites"],
)

godot_project(
    name = "consumer_uses_shared_counter_test_project",
    project_file = "project.godot",
)
