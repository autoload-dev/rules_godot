load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

# The public modules as files, for the registry's documentation and consumers' own.
exports_files(
    [
        "defs.bzl",
        "repositories.bzl",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//godot/extension/private:cc_extension",
        "//godot/extension/private:extension",
        "//godot/extension/private:extension_library",
    ],
)

bzl_library(
    name = "repositories",
    srcs = ["repositories.bzl"],
    deps = ["//godot/extension/private:godot_cpp"],
)
