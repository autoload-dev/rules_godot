load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# The ruleset's packages may depend on this package's implementation libraries, such as
# the bzl_library targets that Gazelle generates; Starlark load visibility still restricts
# who loads its modules.
package(default_visibility = ["//godot:__subpackages__"])

# The descriptor template, which a private attribute of this package's rules names.
exports_files(
    ["descriptor.gdextension.tpl"],
    visibility = ["//visibility:private"],
)

bzl_library(
    name = "cc_extension",
    srcs = ["cc_extension.bzl"],
    deps = [
        ":extension",
        ":extension_library",
        "//godot/private:macros",
        "@rules_cc//cc:cc_library",
    ],
)

bzl_library(
    name = "extension_library",
    srcs = ["extension_library.bzl"],
    deps = [
        ":ios_framework",
        "//godot/private:macros",
        "@bazel_skylib//rules:write_file",
        "@rules_cc//cc:cc_binary",
        "@rules_cc//cc:cc_library",
    ],
)

bzl_library(
    name = "godot_cpp",
    srcs = ["godot_cpp.bzl"],
    deps = [
        ":godot_cpp_api",
        "//godot/private:patches",
        "//godot/private:repository_templates",
        "//godot/private:supply_chain",
    ],
)

bzl_library(
    name = "ios_framework",
    srcs = ["ios_framework.bzl"],
    deps = [
        "//godot/private/config:settings",
        "//godot/private/config:transitions",
        "@apple_support//lib:apple_support",
        "@rules_apple//apple",
    ],
)

bzl_library(
    name = "extension",
    srcs = ["extension.bzl"],
    deps = [
        ":extension_library",
        ":library",
        "//godot/platforms/private:manifest_graph",
        "//godot/private:addon",
        "//godot/private:context",
        "//godot/private:execution",
        "//godot/private:macros",
        "//godot/private:providers",
        "//godot/private:symbols",
        "//godot/private:versions",
        "//godot/private/config:transitions",
        "@rules_apple//apple:aspects",
        "@rules_apple//apple:providers",
        "@rules_cc//cc/common:cc_info",
        "@rules_java//java/common",
    ],
)

bzl_library(
    name = "library",
    srcs = ["library.bzl"],
    deps = [
        "//godot/private:paths",
        "//godot/private:symbols",
        "//godot/private:variant",
        "//godot/private/config:settings",
        "@bazel_skylib//rules:common_settings",
        "@rules_apple//apple:providers",
        "@rules_cc//cc/common:cc_info",
    ],
)

bzl_library(
    name = "bindings",
    srcs = ["bindings.bzl"],
)

bzl_library(
    name = "godot_cpp_api",
    srcs = ["godot_cpp_api.bzl"],
)
