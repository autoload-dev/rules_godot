load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_android//rules:rules.bzl", "android_library")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("//godot/platforms/private:android_runtime_bridge.bzl", "plugin_api_android")
load(":defs.bzl", "godot_export_platform")

package(default_visibility = ["//visibility:public"])

# The public modules as files, for the registry's documentation and consumers' own.
exports_files(
    glob(["*.bzl"]),
    visibility = ["//visibility:public"],
)

# The bundle configuration of Android App Bundles, which the Android application macro
# (godot/platforms/private/android.bzl) passes to the bundle it declares.
exports_files(
    ["android_bundle_config.pb.json"],
    visibility = ["//godot/platforms/private:__pkg__"],
)

godot_export_platform(
    name = "linux_x86_64",
    cpus = ["@platforms//cpu:x86_64"],
    operating_system = "linux",
)

godot_export_platform(
    name = "linux_arm64",
    cpus = ["@platforms//cpu:aarch64"],
    operating_system = "linux",
)

godot_export_platform(
    name = "linux_x86_32",
    cpus = ["@platforms//cpu:x86_32"],
    operating_system = "linux",
)

godot_export_platform(
    name = "linux_arm32",
    cpus = ["@platforms//cpu:armv7"],
    operating_system = "linux",
)

godot_export_platform(
    name = "macos_arm64",
    cpus = ["@platforms//cpu:aarch64"],
    operating_system = "macos",
)

godot_export_platform(
    name = "macos_x86_64",
    cpus = ["@platforms//cpu:x86_64"],
    operating_system = "macos",
)

godot_export_platform(
    name = "android_arm64",
    cpus = ["@platforms//cpu:aarch64"],
    operating_system = "android",
)

godot_export_platform(
    name = "android_x86_64",
    cpus = ["@platforms//cpu:x86_64"],
    operating_system = "android",
)

godot_export_platform(
    name = "android_arm32",
    cpus = ["@platforms//cpu:armv7"],
    operating_system = "android",
)

godot_export_platform(
    name = "android_x86_32",
    cpus = ["@platforms//cpu:x86_32"],
    operating_system = "android",
)

godot_export_platform(
    name = "ios_arm64",
    cpus = ["@platforms//cpu:aarch64"],
    environment = "device",
    operating_system = "ios",
)

godot_export_platform(
    name = "ios_sim_arm64",
    cpus = ["@platforms//cpu:aarch64"],
    environment = "simulator",
    operating_system = "ios",
)

godot_export_platform(
    name = "ios_sim_x86_64",
    cpus = ["@platforms//cpu:x86_64"],
    environment = "simulator",
    operating_system = "ios",
)

# The browser, through Emscripten's WebAssembly, without threads.
godot_export_platform(
    name = "web_wasm32",
    cpus = ["@platforms//cpu:wasm32"],
    operating_system = "web",
)

# Public operating system predicates are reusable for libraries, engines and compatibility.

config_setting(
    name = "is_linux",
    constraint_values = ["@platforms//os:linux"],
)

config_setting(
    name = "is_macos",
    constraint_values = ["@platforms//os:macos"],
)

config_setting(
    name = "is_android",
    constraint_values = ["@platforms//os:android"],
)

# rules_godot calls the operating system web; Bazel's constraint is Emscripten's.
config_setting(
    name = "is_web",
    constraint_values = ["@platforms//os:emscripten"],
)

config_setting(
    name = "is_ios_device",
    constraint_values = [
        "@platforms//os:ios",
        "@apple_support//constraints:device",
    ],
)

config_setting(
    name = "is_ios_simulator",
    constraint_values = [
        "@platforms//os:ios",
        "@apple_support//constraints:simulator",
    ],
)

# The Android shell library's classes for Android plugins to compile against: those of the
# runtime component the configuration's engine and variant resolve, so a plugin compiles
# against the engine its application ships. Never packaged; the application packages its
# runtime itself.
android_library(
    name = "android_plugin_api",
    neverlink = True,
    target_compatible_with = ["@platforms//os:android"],
    exports = [":android_shell"],
)

plugin_api_android(
    name = "android_shell",
    target_compatible_with = ["@platforms//os:android"],
    visibility = ["//visibility:private"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = ["//godot/private/config:settings"],
)

# The entry support every iOS application links, the same for all of them; one target, since
# objc_library rejects the slash of an application backend's name.
objc_library(
    name = "ios_entry_support",
    srcs = ["ios_entry_support.mm"],
    sdk_frameworks = ["UIKit"],
    # Only iOS applications link it; a wildcard build skips it elsewhere.
    target_compatible_with = ["@platforms//os:ios"],
    visibility = ["//godot:__subpackages__"],
)
