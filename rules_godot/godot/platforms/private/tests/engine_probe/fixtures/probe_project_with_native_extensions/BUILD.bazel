load("//godot:app.bzl", "godot_app")
load("//godot:defs.bzl", "godot_pack", "godot_project", "godot_resources")
load("//godot/extension:defs.bzl", "godot_cc_extension")
load("//godot/platforms/private/tests:ios_link.bzl", "ios_unsigned_link")

# A project with a godot-cpp and a C ABI extension, packaged into Android and iOS
# applications for whichever engine the test's configuration selects. main/main.gd is the
# manual mobile runtime acceptance probe; no test runs it. The extensions link statically
# on iOS: the probe's tests inspect the engine and godot-cpp linked into one executable,
# and the iOS smoke and library composition tests cover extension frameworks. The manual
# probe therefore runs the static path; the root module's //e2e/rules_godot/smoke/ios:app embeds
# one.
package(
    default_testonly = True,
    default_visibility = ["//godot/platforms/private/tests/engine_probe:__subpackages__"],
)

godot_cc_extension(
    name = "extension",
    srcs = ["example.cc"],
    entry_symbol = "example_library_init",
    ios_linkage = "static",
    resource_path = "native/cpp_example.gdextension",
    tags = ["manual"],
    deps = ["@godot_cpp"],
)

# The library name libhello.so follows the target name.
godot_cc_extension(
    name = "hello",
    srcs = ["hello.cc"],
    entry_symbol = "rules_godot_library_init",
    ios_linkage = "static",
    resource_path = "native/hello.gdextension",
    tags = ["manual"],
)

godot_resources(
    name = "main",
    srcs = [
        "main/icon.svg",
        "main/main.gd",
        "main/main.tscn",
    ],
    tags = ["manual"],
)

godot_project(
    name = "probe_project_with_native_extensions",
    project_file = "project.godot",
    tags = ["manual"],
)

godot_pack(
    name = "android_pack",
    export_options = {"package/name": '"Bazel Godot Beta"'},
    preset_settings = {"script_export_mode": "0"},
    project = ":probe_project_with_native_extensions",
    tags = ["manual"],
    deps = [
        ":extension",
        ":hello",
        ":main",
    ],
)

godot_pack(
    name = "ios_pack",
    preset_settings = {"script_export_mode": "0"},
    project = ":probe_project_with_native_extensions",
    tags = ["manual"],
    deps = [
        ":extension",
        ":hello",
        ":main",
    ],
)

godot_app(
    name = "android_beta_app",
    application_id = "org.example.rulesgodot.beta",
    pack = ":android_pack",
    tags = ["manual"],
)

godot_app(
    name = "android_beta_source_built_app",
    application_id = "org.example.rulesgodot.beta.source",
    pack = ":android_pack",
    tags = ["manual"],
)

godot_app(
    name = "android_source_built_app",
    application_id = "org.example.rulesgodot.source",
    pack = ":android_pack",
    tags = ["manual"],
)

# The prebuilt beta's simulator engine and AccessKit slices have incompatible CPUs, and a
# device application needs a provisioning profile: link the device executable unsigned.
ios_unsigned_link(
    name = "ios_beta_link",
    pack = ":ios_pack",
    runtime = "@beta_templates_ios//:ios_release",
)

godot_app(
    name = "ios_beta_source_built_app",
    application_id = "org.example.rulesgodot.beta.source",
    pack = ":ios_pack",
    tags = ["manual"],
)

godot_app(
    name = "ios_source_built_app",
    application_id = "org.example.rulesgodot.source",
    pack = ":ios_pack",
    tags = ["manual"],
)
