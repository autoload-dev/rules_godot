load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//godot/private:visibility.bzl", "NOT_ACTUALLY_PUBLIC")

# The ruleset's packages may depend on this package's implementation libraries, such as
# the bzl_library targets that Gazelle generates; Starlark load visibility still restricts
# who loads its modules.
package(default_visibility = ["//godot:__subpackages__"])

# The archives and versions of the Linux Android toolchains, which godot_android_toolchains'
# repositories and the repository's Android requirements check (tools/android at the
# repository's root) read.
exports_files(
    ["android_linux_toolchains.json"],
    visibility = NOT_ACTUALLY_PUBLIC,
)

# Text templates that private attributes of the ruleset's rules and repository rules name;
# the rules of godot/private take the launcher's from launch.bzl.
exports_files(
    glob(["*.tpl"]),
    visibility = ["//godot:__subpackages__"],
)

# The plugin that passes the Godot arguments of bazel run to a debuggable application, a
# private attribute of the Android bootstrap rule (android_bootstrap.bzl).
exports_files(
    ["android/LaunchArgumentsPlugin.java"],
    visibility = ["//visibility:private"],
)

