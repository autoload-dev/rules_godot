load("//godot/engine/private:optimization.bzl", "LTO_DEFAULT", "OPTIMIZE_DEFAULT", "VFE_DEFAULT")
load("//godot/private:visibility.bzl", "NOT_ACTUALLY_PUBLIC")
load(":context.bzl", "no_project")
load(":values.bzl", "bool_value")

package(default_visibility = ["//godot:__subpackages__"])

# The modules, which the package's bzl_library targets list, and the text templates that
# private attributes of its rules name. Private to this package, also in a consumer's
# build without --incompatible_no_implicit_file_export, which would make the files its
# targets use public.
exports_files(
    glob([
        "*.bzl",
        "*.tpl",
    ]),
    visibility = ["//visibility:private"],
)

# The godot_project whose configuration imports use. Operations set it for the
# resources they reach; outside an operation it names no project and nothing imports.
# godot_project, defined in this package, makes every project visible here.
label_setting(
    name = "project_setting",
    build_setting_default = ":no_project",
    visibility = NOT_ACTUALLY_PUBLIC,
)

# What a failed content validation does: fail, the default, fails the build; report
# records the failures in the validation's output and succeeds, for the ruleset's own
# tests of deliberately broken content, which set it through a transition.
string_flag(
    name = "content_validation",
    build_setting_default = "fail",
    values = [
        "fail",
        "report",
    ],
    visibility = ["//godot/private/tests:__subpackages__"],
)

# The value of :project outside every operation: no context, no imports.
no_project(
    name = "no_project",
    visibility = NOT_ACTUALLY_PUBLIC,
)

# The project file of the default project, for projects that only add settings.
exports_files(
    ["default_project.godot"],
    visibility = NOT_ACTUALLY_PUBLIC,
)

# The project of operations that name none, such as a godot_test of a few scripts.
godot_project(
    name = "default_project",
    project_file = "default_project.godot",
    visibility = NOT_ACTUALLY_PUBLIC,
)

# godot_run and godot_test targets without headless select on this; the
# select runs in the caller's package.
config_setting(
    name = "display",
    flag_values = {"//godot:headless": "false"},
    visibility = NOT_ACTUALLY_PUBLIC,
)

# Bazel's --strip, as applications apply it to the native code they package.
config_setting(
    name = "strip_always",
    values = {"strip": "always"},
)

config_setting(
    name = "strip_fastbuild",
    values = {
        "compilation_mode": "fastbuild",
        "strip": "sometimes",
    },
)

bool_value(
    name = "strip",
    value = select({
        ":strip_always": True,
        ":strip_fastbuild": True,
        "//conditions:default": False,
    }),
)

# The build profile of the runtime an application packages, which godot_app's build_profile
# sets at the runtime's edge. Only the class generator of a source recipe reads it; generated
# engine repositories name it, so it is public.
label_flag(
    name = "build_profile",
    build_setting_default = ":no_build_profile",
    visibility = NOT_ACTUALLY_PUBLIC,
)

# The label of that build profile as a string, which godot_app sets with it; empty without
# one. A config_setting cannot compare a label flag that names a file, so the package of a
# source recipe selects the runtime variant of a registered runtime profile with this.
string_flag(
    name = "build_profile_label",
    build_setting_default = "",
    visibility = NOT_ACTUALLY_PUBLIC,
)

# The runtime an application packages needs no tuning: it has no build profile, and it
# compiles outside -c opt or with the default engine optimization. A prebuilt runtime can
# neither leave classes out nor compile otherwise, so where a hub builds the slot from
# source too, its prebuilt component requires :untuned, one of these, and the source-built
# one registered after it serves the other builds. Generated engine hubs name :untuned in
# their toolchains' target_settings; its members stay private.
config_setting(
    name = "untuned_fastbuild",
    flag_values = {":build_profile_label": ""},
    values = {"compilation_mode": "fastbuild"},
    visibility = ["//visibility:private"],
)

config_setting(
    name = "untuned_dbg",
    flag_values = {":build_profile_label": ""},
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:private"],
)

config_setting(
    name = "untuned_defaults",
    flag_values = {
        ":build_profile_label": "",
        "//godot:engine_optimize": OPTIMIZE_DEFAULT,
        "//godot:engine_lto": LTO_DEFAULT,
        "//godot:engine_vfe": str(VFE_DEFAULT),
    },
    visibility = ["//visibility:private"],
)

selects.config_setting_group(
    name = "untuned",
    match_any = [
        ":untuned_fastbuild",
        ":untuned_dbg",
        ":untuned_defaults",
    ],
    visibility = NOT_ACTUALLY_PUBLIC,
)

# No build profile: the class generator keeps every class. Only :build_profile, whose
# default it is, and the transitions that set that flag to it name it.
filegroup(
    name = "no_build_profile",
    srcs = [],
    visibility = ["//visibility:private"],
)

config_setting(
    name = "stamp_enabled",
    values = {"stamp": "1"},
)

# Whether the build stamps, as Bazel's --stamp sets it. The revision rule of generated engine
# repositories reads it through a private attribute, which Bazel checks against the package
# that defines the rule (godot/engine/private/generator.bzl).
bool_value(
    name = "stamp",
    value = select({
        ":stamp_enabled": True,
        "//conditions:default": False,
    }),
)

