load("@rules_python//python:defs.bzl", "py_library")

# The launcher of bazel run on a godot_app. The host's python3 runs these sources
# directly, so they use only the standard library.
filegroup(
    name = "launch",
    srcs = glob([
        "launch*.py",
        "launch*.js",
    ]),
    visibility = ["//tools:ruleset"],
)

py_library(
    name = "launch_lib",
    srcs = glob(["launch*.py"]),
    imports = ["."],
    visibility = ["//tools/platforms/tests:__pkg__"],
)

exports_files(
    [
        "launch.py",
        "launch_web_hook.js",
    ],
    visibility = ["//tools:ruleset"],
)
