amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

// Changed-path selection shared by local checks and CI. Verification profiles
// are opt-in; the default and pre-push hooks run only lightweight checks.
// Policy and profile usage: docs/internal/verification.md.
local function task(name: String): Step = new {
  exclusive = true
  exclude = List("**/*.md")
  check = "mise run \(name)"
}

// What every build reads: the rules, the build tools that builds run, the root module
// and the task commands. Add a build tool here when a build starts to run it.
local core = List(
  "godot/**",
  "tools/BUILD.bazel",
  "tools/*.tpl",
  "tools/godot_*.py",
  "tools/mapped_paths.py",
  "tools/pck.py",
  "tools/common_content.py",
  "tools/digest.py",
  "tools/resource_graph.py",
  "tools/template.py",
  "tools/engine/**",
  "tools/extension/**",
  "tools/action/**",
  "tools/platforms/**",
  "tools/run/**",
  "MODULE.bazel",
  "MODULE.bazel.lock",
  "*_install.json",
  "BUILD.bazel",
  ".bazelrc",
  "shared.bazelrc",
  "tools/bazel",
  ".bazelversion",
  ".bazelignore",
  "mise.toml",
  "mise.lock",
)

// The ruleset's white-box test packages. A change to one selects test:bazel and the tasks
// that run its scripts, not the consumer tasks that merely read the rules in core. A
// package missing here only selects more work.
local whiteBox = List(
  "godot/tests/**",
  "godot/private/tests/**",
  "godot/private/config/tests/**",
  "godot/private/engine/tests/**",
  "godot/engine/private/tests/**",
  "godot/extension/tests/**",
  "godot/platforms/private/tests/**",
  "godot/private/testing/tests/**",
  "tools/tests/**",
  "tools/engine/tests/**",
  "tools/platforms/tests/**",
)

// What a step that reads core ignores: documentation and white-box tests it does not run.
local function consumerExclude(kept: List<String>): List<String> =
  List("**/*.md") + whiteBox.filter((it) -> !kept.contains(it))
local consumerExcludeAll = consumerExclude(List())

// The white-box packages whose tests are tagged source_engine: the source-engine lane runs
// them, test:bazel excludes them.
local sourceEngineTests = List(
  "godot/engine/private/tests/**",
  "godot/extension/tests/**",
  "godot/platforms/private/tests/**",
)

// The consumer module's own declarations: what every task that builds in tests/ reads.
local regressionModule = List(
  "tests/MODULE.bazel",
  "tests/MODULE.bazel.lock",
  "tests/.bazel*",
  "tests/BUILD.bazel",
  "tests/*.json",
)

// What every step that builds in tests/ reads before its own inputs.
local regressionCore = core + regressionModule

// What examples/ and tests/ read of autoload_gdunit, whose gdunit_test runs their GdUnit
// suites: the add-on and the macro, not the module's examples and tests. Only the tasks that
// run GdUnit suites read it. The adapter the macro loads has its own contract test in
// godot/private/tests/adapter, so rule changes alone do not select the module's lane.
local gdunitModule = List(
  "addons/gdunit/MODULE.bazel",
  "addons/gdunit/REPO.bazel",
  "addons/gdunit/BUILD.bazel",
  "addons/gdunit/defs.bzl",
  "addons/gdunit/private/**",
  "addons/gdunit/third_party/**",
)

local conventionSources = List(
  "**/BUILD",
  "**/BUILD.bazel",
  "**/*.bzl",
  "**/MODULE.bazel",
  "**/project.godot",
  "examples/addons/**",
  "examples/projects/**",
  "tests/patched_engine/**",
  "tests/script_run/**",
  "tests/shared_addon/**",
  "tests/smoke/**",
  "tools/conventions/**",
  "addons/*/addon.pkl",
  "hk.pkl",
  "mise.toml",
)

// Inputs of the API output-contract checker beyond the rules themselves. The docs
// task checks registration and the docs lane's cases; the contracts:* tasks check the
// configured cases of their lane.
local apiContracts = List(
  "tools/BUILD.bazel",
  "tools/tool_environment*",
  "tools/docs/**",
  "tools/conventions/context.py",
  "godot/tests/api_contracts/**",
)

// Inputs of one example's host suite beyond its own directories: declarations the example
// alone consumes. Maven pins are not listed: the host suite never builds an Android plugin.
local exampleInputs = new Mapping<String, List<String>> {
  ["sqlite"] = List("examples/deps/sqlite.BUILD.bazel")
  ["platform_paths"] = List()
  ["lichtpost"] = List()
  // A macOS host builds the Apple backend from the Swift package.
  ["app_auth"] = List("examples/Package.swift", "examples/Package.resolved")
  // The lock file that pins the recipes of its source-built engine.
  ["petri"] = List("examples/engines/BUILD.bazel", "examples/engines/godot_petri.lock.json")
  ["dart"] = List("examples/deps/dart_sdk.BUILD.bazel", "examples/deps/dart_sdk.patch")
}

// The add-on modules in addons/: each addons/<module>/addon.pkl names the lanes that verify
// the module and the hosts of its host lane (addons/AGENTS.md); conventions:code checks its
// values. Their lanes run only for changes to the module or the files all modules share:
// rule changes alone do not select them.
local addonLanes = List("host", "android", "ios")
local addonFiles = import*("addons/*/addon.pkl")
local addonModules = new Mapping<String, Dynamic> {
  for (path, addon in addonFiles) {
    // Not the generator's self-test module, addons/.selftest (addon-template below).
    when (!path.startsWith("addons/.")) {
      [path.replaceAll("addons/", "").replaceAll("/addon.pkl", "")] = addon
    }
  }
}
// What every add-on module reads beside its own directory: the shared Bazel settings.
local addonShared = List("addons/*.bazelrc")

// A host lane task limited to some hosts names them, such as host:addon:<module>@macos, so
// that the CI plan leaves it out of other hosts' runners (tools/ci/verification.py); the
// task itself reads addon.pkl. (hk's Pkl compares lists by their joined text.)
local function addonTask(lane: String, module: String, hosts: List<String>): String =
  lane + ":addon:" + module
    + if (lane == "host" && hosts.join(",") != "linux,macos") "@" + hosts.join(",") else ""

// Examples whose suites need a lane other than host: Petri's run in an editor built from
// the engine sources with its module.
local exampleProfiles = new Mapping<String, String> {
  ["petri"] = "source-engine"
}

local checks = new Mapping<String, Step> {
  ["test:setup"] = (task("test:setup")) {
    // The add-on modules' READMEs are inputs of the generated module table.
    exclude = List()
    glob = List(
      "mise.toml",
      "mise.lock",
      "tools/android/**",
      ".codex/environments/**",
      ".github/actions/setup/**",
      // The modules the setup checks find through .bazelignore, and the bazelrc files
      // their .bazelrc imports.
      ".bazelignore",
      "MODULE.bazel",
      ".bazelversion",
      "*.bazelrc",
      ".bazelrc",
      "*/MODULE.bazel",
      "*/.bazelrc",
      "*/.bazelversion",
      "addons/*/MODULE.bazel",
      "addons/*/.bazelrc",
      "addons/*/.bazelversion",
      "addons/*/examples/MODULE.bazel",
      "addons/*/examples/.bazelrc",
      "addons/*/examples/.bazelversion",
      // The files generated from the add-on modules, and what they are generated from.
      "addons/README.md",
      "addons/*/README.md",
      "addons/*/presubmit.yml",
      ".bcr/**",
      "tools/addons/**",
      "tools/setup/**",
      "godot/platforms/private/android_toolchains.bzl",
    )
  }
  ["lint:ci"] = (task("lint:ci")) {
    glob = List(".github/**", "mise.toml", "mise.lock", "hk.pkl")
  }
  ["conventions:code"] = (task("conventions:code")) {
    glob = conventionSources
  }
  ["conventions:docs"] = (task("conventions:docs")) {
    // Source changes can invalidate documented labels too. The two tasks run
    // disjoint rule sets, so mixed changes do not repeat documentation checks.
    glob = conventionSources + List("**/*.md")
    exclude = List()
  }
  ["test:selection"] = (task("test:selection")) {
    glob = List("hk.pkl", "mise.toml", "tools/ci/*.py", ".github/workflows/**")
  }
  ["lint"] = (task("lint")) {
    glob = List(
      "**/*.py",
      "**/*.bzl",
      "**/BUILD",
      "**/BUILD.bazel",
      "**/MODULE.bazel",
      ".buildifier.json",
      "pyproject.toml",
      "hk.pkl",
      "tools/format/**",
      "tools/lint/**",
    )
  }
  ["docs"] = (task("docs")) {
    glob = apiContracts + List(
      "godot/**",
      "docs/public/api/**",
      "tools/docs/**",
      "MODULE.bazel",
      "MODULE.bazel.lock",
      ".bazelversion",
      "mise.toml",
    )
    exclude = List()
  }
  ["test:bazel"] = (task("test:bazel")) {
    profiles = List("host")
    glob = List("**")
    exclude = List(
      "**/*.md",
      ".agents/**",
      "docs/**",
      "examples/**",
      "tests/**",
      "addons/**",
    )
  }
  ["test:regressions"] = (task("test:regressions")) {
    profiles = List("host")
    exclude = consumerExcludeAll
    glob = core + List("tests/**") + gdunitModule
  }
  for (example, inputs in exampleInputs) {
    ["test:example:" + example] = (task("test:example:" + example)) {
      profiles = List(if (exampleProfiles.containsKey(example)) exampleProfiles[example] else "host")
      exclude = consumerExcludeAll
      glob = core + List(
        "examples/MODULE.bazel",
        "examples/MODULE.bazel.lock",
        "examples/.bazel*",
        "examples/*.bzl",
        "examples/BUILD.bazel",
        "examples/deps/BUILD.bazel",
        "examples/addons/" + example + "/**",
        "examples/projects/" + example + "/**",
      ) + gdunitModule + inputs
    }
  }
  for (module, addon in addonModules) {
    for (lane in addon.lanes) {
      [addonTask(lane, module, addon.hosts)] = (task("addon:" + lane + " " + module)) {
        profiles = List(lane)
        glob = List("addons/" + module + "/**") + addonShared
      }
    }
  }
  // The add-on generator's self-test: a module generated from its template, in each lane.
  // Its desktop build does the same on every host, so its host lane runs on Linux only.
  for (lane in addonLanes) {
    [lane + ":addon-template" + if (lane == "host") "@linux" else ""] =
      (task("addon:template " + lane)) {
        profiles = List(lane)
        glob = List(
          "tools/addons/template/**",
          "tools/addons/new.py",
          "tools/addons/lanes.py",
          "tools/addons/modules.py",
          "tools/setup/modules.py",
          "tools/resource_uids.py",
        ) + addonShared
      }
  }
  ["test:gdextension"] = (task("test:gdextension")) {
    profiles = List("host")
    exclude = consumerExcludeAll
    glob = regressionCore + List(
      "tests/smoke/linux/**",
      "tests/smoke/macos/**",
      "tools/tool_environment.py",
    )
  }
  for (lane in List("host", "source-engine", "android", "ios")) {
    ["contracts:" + lane] = (task("contracts:" + lane)) {
      profiles = List(lane)
      exclude = consumerExclude(List("godot/tests/**"))
      // The consumer scenarios that host cases or behavior tests of a lane.
      // tools/ci/selection_test.py checks the packages that
      // godot/tests/api_contracts/cases.bzl names against this list.
      glob = core + apiContracts + regressionModule
    }
  }
  // The consumer's patched engines and the ruleset's tests tagged source_engine.
  ["source-engine"] = (task("source-engine")) {
    profiles = List("source-engine")
    exclude = consumerExclude(sourceEngineTests)
    glob = regressionCore + sourceEngineTests + List(
      "tests/patched_engine/**",
      "tools/android/**",
      "tools/tool_environment.py",
      ".github/**",
      "tools/ci/**",
    )
  }
  ["ios"] = (task("ios")) {
    profiles = List("ios")
    exclude = consumerExcludeAll
    glob = regressionCore + List(
      "examples/**",
      "tests/smoke/ios/**",
      "tools/tool_environment.py",
      ".github/**",
      "tools/ci/**",
    )
  }
  ["android"] = (task("android")) {
    profiles = List("android")
    exclude = consumerExcludeAll
    glob = regressionCore + List(
      "tools/android/**",
      "examples/**",
      "tools/tool_environment.py",
      "tests/smoke/android/**",
      ".github/**",
      "tools/ci/**",
    )
  }
}

hooks {
  ["check"] {
    steps = checks
  }
  ["pre-push"] {
    steps {
      ["pushed-checkout"] {
        exclusive = true
        check = "bash tools/pre_push_checkout.sh"
        stdin = "{{ hook_stdin }}"
      }
      for (name, step in checks) {
        when (step.profiles == null || step.profiles.isEmpty) {
          [name] = step
        }
      }
    }
  }
}
